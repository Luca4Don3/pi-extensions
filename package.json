{
  "name": "@luca4don3/pi-extensions",
  "version": "0.8.0-beta.1",
  "description": "A collection of independently installable Pi extensions: subagent, chinese-prompt, opencode-fallback, and token-speed.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-extensions",
    "subagent",
    "token-speed"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luca4Don3/pi-extensions.git"
  },
  "homepage": "https://github.com/Luca4Don3/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/Luca4Don3/pi-extensions/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "extensions/*/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --project tsconfig.json",
    "test": "node --test extensions/*/tests/*.test.mjs"
  }
}
